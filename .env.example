# ConFlow 服务端环境变量（复制为 .env 后填写；全部有内置默认，可按需删减）

# ── 语义生成（必填其一：这里的 key 或后台「系统配置」里填，后台优先）──
CONFLOW_LLM_API_KEY=sk-你的key
CONFLOW_LLM_BASE_URL=https://api.deepseek.com/v1
CONFLOW_LLM_MODEL=deepseek-chat
# CONFLOW_LLM_MAX_TOKENS=8192

# ── 安全（公网部署务必设置，否则 API 写接口对任何访问者开放）──
# CONFLOW_TOKEN=生成一个随机串: openssl rand -hex 24

# ── 推送（详见后台「系统配置 → 推送到内容库」，也可全部在后台配置）──
# CONFLOW_PUSH_TARGET=openflow            # openflow | wordpress | static | webhook
# CONFLOW_OPENFLOW_DATA=/www/wwwroot/nownexts_com/data
# CONFLOW_PUSH_STATIC_DIR=/www/wwwroot/mysite/conflow
# CONFLOW_PUSH_WEBHOOK=https://hooks.example.com/conflow

# ── 转写兜底（无字幕视频；模型首次使用自动下载）──
# CONFLOW_WHISPER_MODEL=small             # tiny/base/small/medium/large-v3
# CONFLOW_WHISPER_BACKEND=faster_whisper  # 强制后端：mlx_whisper / faster_whisper / whisper

# ── 其他 ──
# CONFLOW_WORKERS=1                       # 任务并发数
# CONFLOW_PUBLIC_BASE=/VTH                # 本站 slides 对外前缀（子路径部署时）
# CONFLOW_PROXY=http://127.0.0.1:6152     # 抓取代理（留空自动探测本地代理端口）
